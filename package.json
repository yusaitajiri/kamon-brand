{
  "name": "@yusai/kamon-react",
  "version": "1.0.0",
  "description": "The kamon brand kit for React on the web and Tauri: tokens, ui.css, components, logos, app icons and the brand-ui skill for coding agents.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./react/dist/index.d.ts",
      "default": "./react/dist/index.js"
    },
    "./tokens": {
      "types": "./react/dist/tokens.d.ts",
      "default": "./react/dist/tokens.js"
    },
    "./tokens/tokens.css": "./react/tokens/tokens.css",
    "./tokens/tokens.json": "./tokens/tokens.json",
    "./ui/ui.css": "./react/ui/ui.css",
    "./logo/*": "./logo/*",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "brand-sync": "react/scripts/brand-sync.mjs"
  },
  "files": [
    "react/dist/",
    "react/tokens/",
    "react/ui/ui.css",
    "react/skills/",
    "react/scripts/brand-sync.mjs",
    "react/README.md",
    "react/CHANGELOG.md",
    "tokens/tokens.json",
    "logo/",
    "icons/",
    "LICENSE",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "generate": "node react/scripts/generate.mjs",
    "build": "tsc -p react/tsconfig.json",
    "demo": "vite react/demo",
    "check": "npm run generate && npm run build && git diff --exit-code -- react/tokens react/src react/dist react/skills"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
